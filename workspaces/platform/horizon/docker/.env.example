# Horizon Platform - Environment Variables
# ==========================================
# Copy this file to ../.env and customize values for your environment
#
# Usage:
#   cp docker/.env.example .env
#   docker-compose up -d

# ===================
# Database
# ===================
POSTGRES_PASSWORD=devpassword

# ===================
# Object Storage (MinIO)
# ===================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ===================
# Analytics (ClickHouse)
# ===================
CLICKHOUSE_PASSWORD=devpassword

# ===================
# Identity (Keycloak)
# ===================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ===================
# Monitoring (Grafana)
# ===================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ===================
# AI Services - Claude Code Agent SDK
# ===================
# Authentication via Claude Code OAuth
# See: https://docs.anthropic.com/claude-code-agent-sdk

# CLAUDE_CODE_OAUTH_TOKEN=...
