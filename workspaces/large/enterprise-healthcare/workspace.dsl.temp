workspace "Enterprise Healthcare System" "Comprehensive hospital information system architecture with EHR, clinical, and administrative systems" {

    !const AZURE_COLOR "#0078D4"
    !const CLINICAL_COLOR "#2E7D32"
    !const ADMIN_COLOR "#F57C00"
    !const INFRA_COLOR "#455A64"
    !const EXTERNAL_COLOR "#5E35B1"
    !const DATABASE_COLOR "#1565C0"
    !const QUEUE_COLOR "#C62828"

    !impliedRelationships false

    !docs "docs"
    !adrs "adrs"

    model {
        # People / Actors
        doctor = person "Doctor" "Physician providing patient care" {
            perspectives {
                "Compliance" "HIPAA-covered entity"
                "Criticality" "Mission-critical user"
            }
        }

        nurse = person "Nurse" "Registered nurse coordinating patient care" {
            perspectives {
                "Compliance" "HIPAA-covered entity"
                "Criticality" "Mission-critical user"
            }
        }

        patient = person "Patient" "Person receiving healthcare services" {
            perspectives {
                "Compliance" "Protected Health Information subject"
                "Data Classification" "PHI owner"
            }
        }

        admin = person "Administrative Staff" "Scheduling and administrative personnel" {
            perspectives {
                "Compliance" "HIPAA-covered entity"
                "Criticality" "High"
            }
        }

        labTech = person "Lab Technician" "Laboratory testing specialist" {
            perspectives {
                "Compliance" "HIPAA-covered entity"
                "Criticality" "High"
            }
        }

        pharmacist = person "Pharmacist" "Medication dispensing specialist" {
            perspectives {
                "Compliance" "HIPAA-covered entity"
                "Criticality" "Mission-critical user"
            }
        }

        radiologist = person "Radiologist" "Medical imaging specialist" {
            perspectives {
                "Compliance" "HIPAA-covered entity"
                "Criticality" "High"
            }
        }

        billingStaff = person "Billing Staff" "Revenue cycle management personnel" {
            perspectives {
                "Compliance" "HIPAA-covered entity (billing)"
                "Criticality" "Medium"
            }
        }

        # External Systems
        insuranceProvider = softwareSystem "Insurance Provider" "External insurance payer systems" {
            perspectives {
                "Compliance" "HIPAA Business Associate"
                "Integration" "X12 EDI"
            }
        }

        pharmacyNetwork = softwareSystem "Pharmacy Network" "External retail pharmacy network" {
            perspectives {
                "Compliance" "HIPAA Business Associate"
                "Integration" "NCPDP SCRIPT"
            }
        }

        # Main Software Systems
        group "Clinical Systems" {
            ehr = softwareSystem "Electronic Health Record" "Core clinical system managing patient records and care workflows" {
                perspectives {
                    "Compliance" "HIPAA-compliant, FDA 21 CFR Part 11"
                    "Criticality" "Mission-critical"
                    "Data Classification" "PHI"
                }

                ehrWeb = container "EHR Web Application" "Clinician-facing web interface" "React, TypeScript" "WebApp,Clinical" {
                    perspectives {
                        "Technology" "SPA with SMART on FHIR"
                    }
                }

                ehrApi = container "EHR API Gateway" "RESTful FHIR API" "Java Spring Boot" "API,Clinical" {
                    perspectives {
                        "Technology" "Spring Cloud Gateway"
                        "Security" "OAuth 2.0, JWT"
                    }
                }

                patientService = container "Patient Service" "Patient demographics and registration" "Java Spring Boot" "Backend,Clinical"

                clinicalService = container "Clinical Service" "Clinical documentation and orders" "Java Spring Boot" "Backend,Clinical"

                cdsContainer = container "Clinical Decision Support" "Alert and decision support engine" "Java Spring Boot" "Backend,Clinical,CDS" {
                    perspectives {
                        "Criticality" "Mission-critical"
                        "Regulations" "CMS, FDA"
                    }

                    rulesEngine = component "Rules Engine" "Evaluates clinical rules and protocols" "Drools" "CDS"
                    drugChecker = component "Drug Interaction Checker" "Checks medication contraindications" "Java" "CDS,Safety"
                    alertGenerator = component "Alert Generator" "Creates and manages clinical alerts" "Java" "CDS"
                    protocolManager = component "Protocol Manager" "Manages clinical pathways and protocols" "Java" "CDS"

                    rulesEngine -> drugChecker "Invokes"
                    rulesEngine -> alertGenerator "Triggers"
                    protocolManager -> rulesEngine "Configures"
                }

                ehrDatabase = container "EHR Database" "Patient records and clinical data" "PostgreSQL" "Database,Clinical" {
                    perspectives {
                        "Data Classification" "PHI"
                        "Encryption" "TDE enabled"
                    }
                }

                ehrCache = container "EHR Cache" "Session and query cache" "Redis" "Cache,Infrastructure"

                messageQueue = container "Integration Queue" "Async messaging for integrations" "RabbitMQ" "Queue,Infrastructure" {
                    perspectives {
                        "Pattern" "Event-driven architecture"
                    }
                }

                ehrWeb -> ehrApi "Makes API calls" "HTTPS/REST"
                ehrApi -> patientService "Routes requests"
                ehrApi -> clinicalService "Routes requests"
                ehrApi -> cdsContainer "Routes requests"
                patientService -> ehrDatabase "Reads/writes" "JDBC"
                clinicalService -> ehrDatabase "Reads/writes" "JDBC"
                cdsContainer -> ehrDatabase "Reads" "JDBC"
                patientService -> ehrCache "Caches" "Redis Protocol"
                clinicalService -> messageQueue "Publishes events" "AMQP"
            }

            emergency = softwareSystem "Emergency Department System" "ED tracking and triage" {
                perspectives {
                    "Criticality" "Mission-critical"
                    "Data Classification" "PHI"
                }

                edWeb = container "ED Web UI" "Emergency department dashboard" "Vue.js" "WebApp,Clinical"
                edApi = container "ED API" "ED workflow API" "Node.js" "API,Clinical"
                edDatabase = container "ED Database" "ED encounters and triage" "PostgreSQL" "Database,Clinical"

                edWeb -> edApi "Uses"
                edApi -> edDatabase "Reads/writes"
            }

            lab = softwareSystem "Laboratory Information System" "Lab order and result management" {
                perspectives {
                    "Compliance" "CLIA, CAP"
                    "Criticality" "Mission-critical"
                    "Data Classification" "PHI"
                }

                labWeb = container "Lab Web Portal" "Lab technician interface" "React" "WebApp,Clinical"
                labApi = container "Lab API" "Lab order and result API" "Python FastAPI" "API,Clinical"
                labDatabase = container "Lab Database" "Test results and orders" "PostgreSQL" "Database,Clinical"
                labWorker = container "Lab Interface Worker" "Instrument interface processor" "Python" "Worker,Clinical"
                instrumentQueue = container "Instrument Queue" "Lab device messages" "RabbitMQ" "Queue,Infrastructure"

                labWeb -> labApi "Uses"
                labApi -> labDatabase "Reads/writes"
                labWorker -> labDatabase "Writes results"
                labWorker -> instrumentQueue "Consumes" "AMQP"
            }

            pharmacy = softwareSystem "Pharmacy Management System" "Medication order and dispensing" {
                perspectives {
                    "Compliance" "DEA, State Pharmacy Board"
                    "Criticality" "Mission-critical"
                    "Data Classification" "PHI"
                }

                pharmacyWeb = container "Pharmacy Web UI" "Pharmacist workflow interface" "React" "WebApp,Clinical"
                pharmacyApi = container "Pharmacy API" "Medication order API" "Java Spring Boot" "API,Clinical"
                pharmacyDatabase = container "Pharmacy Database" "Medication orders and inventory" "PostgreSQL" "Database,Clinical"
                dispensingSystem = container "Automated Dispensing" "Robot dispensing interface" "Java" "Worker,Clinical"

                pharmacyWeb -> pharmacyApi "Uses"
                pharmacyApi -> pharmacyDatabase "Reads/writes"
                pharmacyApi -> dispensingSystem "Sends dispense commands"
            }

            radiology = softwareSystem "Radiology PACS" "Medical imaging and reporting" {
                perspectives {
                    "Compliance" "FDA, ACR"
                    "Criticality" "High"
                    "Data Classification" "PHI"
                    "Standards" "DICOM, HL7"
                }

                pacsViewer = container "PACS Viewer" "Medical image viewer" "Java Swing" "Desktop,Clinical"
                pacsApi = container "PACS API" "Imaging study API" "Java" "API,Clinical"
                dicomStore = container "DICOM Storage" "Medical image archive" "dcm4che, PostgreSQL" "Storage,Clinical"

                pacsViewer -> pacsApi "Retrieves images"
                pacsApi -> dicomStore "Stores/retrieves"
            }
        }

        group "Administrative Systems" {
            scheduling = softwareSystem "Appointment Scheduling" "Patient appointment management" {
                perspectives {
                    "Criticality" "High"
                    "Data Classification" "PII"
                }

                schedulingWeb = container "Scheduling Web App" "Appointment booking interface" "React" "WebApp,Administrative"
                schedulingApi = container "Scheduling API" "Appointment API" "Node.js" "API,Administrative"
                schedulingDb = container "Scheduling Database" "Appointments and resources" "MongoDB" "Database,Administrative"

                schedulingWeb -> schedulingApi "Uses"
                schedulingApi -> schedulingDb "Reads/writes"
            }

            billing = softwareSystem "Billing System" "Revenue cycle and claims management" {
                perspectives {
                    "Compliance" "HIPAA (billing), IRS"
                    "Criticality" "High"
                    "Data Classification" "PHI, Financial"
                }

                billingWeb = container "Billing Web Portal" "Claims and billing interface" "React" "WebApp,Administrative"
                billingApi = container "Billing API" "Claims processing API" "Java Spring Boot" "API,Administrative"
                billingDb = container "Billing Database" "Claims and payments" "PostgreSQL" "Database,Administrative"
                claimsWorker = container "Claims Processing Worker" "EDI claim submission" "Java" "Worker,Administrative"

                billingWeb -> billingApi "Uses"
                billingApi -> billingDb "Reads/writes"
                claimsWorker -> billingDb "Reads claims"
            }

            analytics = softwareSystem "Analytics Platform" "Business intelligence and reporting" {
                perspectives {
                    "Criticality" "Medium"
                    "Data Classification" "De-identified PHI"
                }

                analyticsWeb = container "Analytics Dashboard" "BI dashboard" "React, D3.js" "WebApp,Administrative"
                analyticsApi = container "Analytics API" "Reporting API" "Python FastAPI" "API,Administrative"
                dataWarehouse = container "Data Warehouse" "OLAP data store" "Azure Synapse" "Database,Cloud,Administrative"
                etlPipeline = container "ETL Pipeline" "Data transformation jobs" "Apache Airflow" "Worker,Administrative"

                analyticsWeb -> analyticsApi "Uses"
                analyticsApi -> dataWarehouse "Queries"
                etlPipeline -> dataWarehouse "Loads data"
            }
        }

        group "Infrastructure Systems" {
            integrationHub = softwareSystem "Integration Hub" "HL7 interface engine and API gateway" {
                perspectives {
                    "Criticality" "Mission-critical"
                    "Pattern" "Enterprise Service Bus"
                }

                hl7Router = container "HL7 Message Router" "HL7 v2 message routing" "Mirth Connect" "Integration,Infrastructure"
                fhirGateway = container "FHIR Gateway" "FHIR API aggregation" "Java Spring Boot" "API,Infrastructure"
                integrationDb = container "Integration Database" "Message logs and routing" "PostgreSQL" "Database,Infrastructure"

                hl7Router -> integrationDb "Logs messages"
                fhirGateway -> integrationDb "Logs API calls"
            }

            identity = softwareSystem "Identity Management" "Authentication and authorization" {
                perspectives {
                    "Compliance" "HIPAA (access control)"
                    "Criticality" "Mission-critical"
                    "Security" "MFA, SSO"
                }

                identityServer = container "Identity Server" "OAuth/OIDC provider" "Keycloak" "Security,Infrastructure"
                userDirectory = container "User Directory" "User and role store" "LDAP" "Database,Infrastructure"

                identityServer -> userDirectory "Authenticates against"
            }

            compliance = softwareSystem "Compliance & Audit" "Audit logging and compliance monitoring" {
                perspectives {
                    "Compliance" "HIPAA (audit controls)"
                    "Criticality" "High"
                }

                auditCollector = container "Audit Collector" "Centralized audit log aggregator" "Elasticsearch, Logstash" "Infrastructure,Security"
                complianceDb = container "Audit Database" "Immutable audit log" "Elasticsearch" "Database,Infrastructure"
                complianceDashboard = container "Compliance Dashboard" "Audit reporting UI" "Kibana" "WebApp,Infrastructure"

                auditCollector -> complianceDb "Writes"
                complianceDashboard -> complianceDb "Queries"
            }
        }

        group "External Systems" {
            patientPortal = softwareSystem "Patient Portal" "Patient self-service web portal" {
                perspectives {
                    "Compliance" "HIPAA, HITECH (patient access)"
                    "Criticality" "High"
                    "Data Classification" "PHI"
                }

                portalWeb = container "Portal Web App" "Patient-facing web application" "React" "WebApp,External"
                portalApi = container "Portal API" "Patient API" "Node.js" "API,External"
                portalDb = container "Portal Database" "Patient messages and preferences" "MongoDB" "Database,External"

                portalWeb -> portalApi "Uses"
                portalApi -> portalDb "Reads/writes"
            }
        }

        # User -> System Relationships
        doctor -> ehr "Documents patient care, orders tests and medications"
        doctor -> emergency "Manages emergency patients"
        doctor -> patientPortal "Reviews patient messages"

        nurse -> ehr "Documents nursing care, administers medications"
        nurse -> emergency "Triages and treats emergency patients"

        patient -> patientPortal "Views records, schedules appointments, messages providers"

        admin -> scheduling "Manages appointments"
        admin -> ehr "Registers patients"

        labTech -> lab "Processes specimens, enters results"

        pharmacist -> pharmacy "Verifies and dispenses medications"

        radiologist -> radiology "Interprets imaging studies"

        billingStaff -> billing "Submits claims, processes payments"

        # System -> System Relationships
        ehr -> integrationHub "Sends HL7 messages and FHIR resources"
        emergency -> integrationHub "Sends patient encounters"
        lab -> integrationHub "Sends lab orders and results"
        pharmacy -> integrationHub "Sends medication orders"
        radiology -> integrationHub "Sends imaging orders and results"

        integrationHub -> ehr "Routes messages to"
        integrationHub -> emergency "Routes messages to"
        integrationHub -> lab "Routes messages to"
        integrationHub -> pharmacy "Routes messages to"
        integrationHub -> radiology "Routes messages to"

        patientPortal -> integrationHub "Queries patient data via FHIR"

        scheduling -> ehr "Syncs patient demographics"

        billing -> ehr "Retrieves encounter and diagnosis data"
        billing -> insuranceProvider "Submits claims" "X12 EDI"

        pharmacy -> pharmacyNetwork "Sends prescriptions" "NCPDP SCRIPT"

        analytics -> ehr "Extracts clinical data"
        analytics -> billing "Extracts financial data"
        analytics -> lab "Extracts lab data"

        ehr -> identity "Authenticates users"
        emergency -> identity "Authenticates users"
        lab -> identity "Authenticates users"
        pharmacy -> identity "Authenticates users"
        radiology -> identity "Authenticates users"
        scheduling -> identity "Authenticates users"
        billing -> identity "Authenticates users"
        patientPortal -> identity "Authenticates users"

        ehr -> compliance "Sends audit events"
        emergency -> compliance "Sends audit events"
        lab -> compliance "Sends audit events"
        pharmacy -> compliance "Sends audit events"
        radiology -> compliance "Sends audit events"
        patientPortal -> compliance "Sends audit events"

        # Container-level relationships
        ehrApi -> fhirGateway "Queries via FHIR"
        labApi -> hl7Router "Sends HL7 messages"
        pharmacyApi -> hl7Router "Sends HL7 messages"
        pacsApi -> hl7Router "Sends HL7 messages"
        edApi -> hl7Router "Sends HL7 messages"

        portalApi -> fhirGateway "Queries patient data"

        ehrApi -> identityServer "Validates tokens"
        labApi -> identityServer "Validates tokens"
        pharmacyApi -> identityServer "Validates tokens"

        messageQueue -> auditCollector "Streams events"
        integrationDb -> auditCollector "Streams logs"

        etlPipeline -> ehrDatabase "Extracts data"
        etlPipeline -> billingDb "Extracts data"
        etlPipeline -> labDatabase "Extracts data"

        billingApi -> insuranceProvider "Submits claims via EDI"

        # Component relationships
        ehrApi -> rulesEngine "Requests decision support"
        clinicalService -> rulesEngine "Validates orders"
        drugChecker -> ehrDatabase "Queries patient medications"
        alertGenerator -> messageQueue "Publishes alerts"
    }

    views {
        systemLandscape "SystemLandscape" "Complete hospital IT ecosystem" {
            include *
            autoLayout
        }

        systemContext ehr "EHRContext" "Electronic Health Record system context" {
            include *
            autoLayout
        }

        container ehr "EHRContainers" "EHR internal architecture" {
            include *
            autoLayout
        }

        container lab "LabContainers" "Laboratory Information System containers" {
            include *
            autoLayout
        }

        container pharmacy "PharmacyContainers" "Pharmacy Management System containers" {
            include *
            autoLayout
        }

        component cdsContainer "CDSComponents" "Clinical Decision Support internal components" {
            include *
            autoLayout
        }

        dynamic ehr "PatientAdmission" "Patient admission workflow from ED to inpatient" {
            nurse -> edWeb "1. Creates encounter"
            edWeb -> edApi "2. Submits encounter"
            edApi -> edDatabase "3. Saves encounter"
            edApi -> hl7Router "4. Sends ADT message"
            hl7Router -> ehrApi "5. Routes ADT to EHR"
            ehrApi -> patientService "6. Updates patient"
            doctor -> ehrWeb "7. Orders lab tests"
            ehrWeb -> clinicalService "8. Creates orders"
            clinicalService -> messageQueue "9. Publishes order event"
            messageQueue -> hl7Router "10. Sends to Lab"
            hl7Router -> labApi "11. Creates lab order"
            labTech -> labWeb "12. Processes specimen"
            labWorker -> labDatabase "13. Receives results"
            labApi -> hl7Router "14. Sends results"
            hl7Router -> ehrApi "15. Routes to EHR"
            ehrApi -> clinicalService "16. Updates results"
            doctor -> ehrWeb "17. Reviews results"
            autoLayout
        }

        dynamic pharmacy "PrescriptionWorkflow" "Medication ordering and dispensing" {
            doctor -> ehrWeb "1. Prescribes medication"
            ehrWeb -> ehrApi "2. Submits order"
            ehrApi -> cdsContainer "3. Check interactions"
            rulesEngine -> drugChecker "4. Validate"
            drugChecker -> alertGenerator "5. Alert if issue"
            ehrApi -> clinicalService "6. Save order"
            clinicalService -> messageQueue "7. Publish event"
            messageQueue -> hl7Router "8. Route to pharmacy"
            hl7Router -> pharmacyApi "9. Create order"
            pharmacyApi -> pharmacyDatabase "10. Save"
            pharmacist -> pharmacyWeb "11. Verify order"
            pharmacyWeb -> pharmacyApi "12. Confirm"
            pharmacyApi -> dispensingSystem "13. Dispense"
            dispensingSystem -> pharmacyApi "14. Confirm dispensed"
            pharmacyApi -> hl7Router "15. Send status"
            hl7Router -> ehrApi "16. Update EHR"
            autoLayout
        }

        deployment ehr "Production" "ProductionDeployment" "Hybrid on-premise and Azure cloud deployment" {
            deploymentNode "On-Premise Datacenter" {
                tags "Datacenter"

                deploymentNode "Application Tier" {
                    tags "AppServer"

                    deploymentNode "EHR App Server 1" {
                        ehrWebInst1 = containerInstance ehrWeb
                        ehrApiInst1 = containerInstance ehrApi
                        patientServiceInst1 = containerInstance patientService
                        clinicalServiceInst1 = containerInstance clinicalService
                        cdsContainerInst1 = containerInstance cdsContainer
                    }

                    deploymentNode "EHR App Server 2" {
                        ehrWebInst2 = containerInstance ehrWeb
                        ehrApiInst2 = containerInstance ehrApi
                        patientServiceInst2 = containerInstance patientService
                        clinicalServiceInst2 = containerInstance clinicalService
                    }
                }

                deploymentNode "Database Tier" {
                    tags "Database"

                    deploymentNode "PostgreSQL Cluster" {
                        ehrDatabaseInst = containerInstance ehrDatabase
                    }

                    deploymentNode "Redis Cluster" {
                        ehrCacheInst = containerInstance ehrCache
                    }
                }

                deploymentNode "Integration Tier" {
                    tags "Integration"

                    deploymentNode "Integration Server" {
                        messageQueueInst = containerInstance messageQueue
                        hl7RouterInst = containerInstance hl7Router
                        fhirGatewayInst = containerInstance fhirGateway
                    }
                }

                deploymentNode "Ancillary Systems" {
                    tags "Ancillary"

                    deploymentNode "Lab Server" {
                        labWebInst = containerInstance labWeb
                        labApiInst = containerInstance labApi
                        labDatabaseInst = containerInstance labDatabase
                    }

                    deploymentNode "Pharmacy Server" {
                        pharmacyWebInst = containerInstance pharmacyWeb
                        pharmacyApiInst = containerInstance pharmacyApi
                        pharmacyDatabaseInst = containerInstance pharmacyDatabase
                    }
                }
            }

            deploymentNode "Azure Cloud" {
                tags "Cloud,Azure"

                deploymentNode "Azure App Service" {
                    tags "PaaS"
                    portalWebInst = containerInstance portalWeb
                    portalApiInst = containerInstance portalApi
                }

                deploymentNode "Azure Cosmos DB" {
                    tags "PaaS,Database"
                    portalDbInst = containerInstance portalDb
                }

                deploymentNode "Azure Synapse Analytics" {
                    tags "PaaS,Analytics"
                    dataWarehouseInst = containerInstance dataWarehouse
                    etlPipelineInst = containerInstance etlPipeline
                }
            }
        }

        styles {
            element "Person" {
                shape Person
                background "#08427b"
                color "#ffffff"
            }

            element "HealthcareProfessional" {
                background "#1565C0"
            }

            element "Patient" {
                background "#5E35B1"
            }

            element "External" {
                background "#424242"
            }

            element "Clinical" {
                background "#2E7D32"
                color "#ffffff"
            }

            element "Administrative" {
                background "#F57C00"
                color "#ffffff"
            }

            element "Infrastructure" {
                background "#455A64"
                color "#ffffff"
            }

            element "Core" {
                border Solid
            }

            element "WebApp" {
                shape WebBrowser
            }

            element "API" {
                shape Hexagon
            }

            element "Database" {
                shape Cylinder
                background "#1565C0"
                color "#ffffff"
            }

            element "Queue" {
                shape Pipe
                background "#C62828"
                color "#ffffff"
            }

            element "Cache" {
                shape Cylinder
                background "#E65100"
            }

            element "Worker" {
                shape Robot
            }

            element "Security" {
                background "#000000"
                color "#ffffff"
            }

            element "Cloud" {
                background "#0078D4"
            }

            element "Azure" {
                color "#ffffff"
            }

            element "CDS" {
                background "#D32F2F"
                color "#ffffff"
            }

            element "Datacenter" {
                background "#ECEFF1"
            }

            element "PaaS" {
                background "#4FC3F7"
            }

            relationship "Relationship" {
                routing Orthogonal
                thickness 2
            }
        }

        theme default
    }
}
